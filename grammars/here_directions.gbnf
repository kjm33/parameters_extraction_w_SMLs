root ::= "{" kvs "}"
kvs ::= kv-0 "," kv-1 "," kv-2 "," kv-3 "," kv-4 "," kv-5 "," kv-6 "," kv-7
ws ::= [ \t\n]*
str ::= "\"" ([^"\\\x7F\x00-\x1F] | "\\" (["\\bfnrt] | "u" [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F]))* "\""
num ::= [0-9]+
kv-0 ::= "transportMode" ":" val-0
val-0 ::= ("car" | "truck" | "pedestrian" | "bicycle" | "scooter" | "null")
kv-1 ::= "origin" ":" val-1
val-1 ::= (str | "null")
kv-2 ::= "destination" ":" val-2
val-2 ::= (str | "null")
kv-3 ::= "via" ":" val-3
val-3 ::= ("[" ws str (ws "," ws str)* ws "]" | "null")
kv-4 ::= "departureTime" ":" val-4
val-4 ::= (str | "null")
kv-5 ::= "routingMode" ":" val-5
val-5 ::= ("fast" | "short" | "null")
kv-6 ::= "avoid_features" ":" val-6
val-6 ::= ("[" ws ("tollRoad" | "ferry" | "motorway" | "tunnel") (ws "," ws ("tollRoad" | "ferry" | "motorway" | "tunnel"))* ws "]" | "null")
kv-7 ::= "lang" ":" val-7
val-7 ::= (str | "null")
