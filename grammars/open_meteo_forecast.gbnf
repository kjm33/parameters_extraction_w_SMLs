root ::= "{" kvs "}"
kvs ::= kv-0 "," kv-1 "," kv-2
ws ::= [ \t\n]*
str ::= "\"" ([^"\\\x7F\x00-\x1F] | "\\" (["\\bfnrt] | "u" [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F]))* "\""
num ::= [0-9]+
kv-0 ::= "latitude" ":" val-0
val-0 ::= (num | "null")
kv-1 ::= "longitude" ":" val-1
val-1 ::= (num | "null")
kv-2 ::= "days" ":" val-2
val-2 ::= (num | "null")
