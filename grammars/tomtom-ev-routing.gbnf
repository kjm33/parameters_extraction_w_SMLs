root ::= "{" kvs "}"
kvs ::= kv-0 "," kv-1 "," kv-2 "," kv-3 "," kv-4 "," kv-5 "," kv-6 "," kv-7 "," kv-8 "," kv-9 "," kv-10 "," kv-11 "," kv-12 "," kv-13 "," kv-14
ws ::= [ \t\n]*
str ::= "\"" ([^"\\\x7F\x00-\x1F] | "\\" (["\\bfnrt] | "u" [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F]))* "\""
num ::= [0-9]+
kv-0 ::= "origin" ":" val-0
val-0 ::= ("[" ws str (ws "," ws str)* ws "]" | "null")
kv-1 ::= "destination" ":" val-1
val-1 ::= ("[" ws str (ws "," ws str)* ws "]" | "null")
kv-2 ::= "waypoints" ":" val-2
val-2 ::= ("[" ws str (ws "," ws str)* ws "]" | "null")
kv-3 ::= "currentChargePercent" ":" val-3
val-3 ::= (num | "null")
kv-4 ::= "maxChargeKWH" ":" val-4
val-4 ::= (num | "null")
kv-5 ::= "consumptionInKWH" ":" val-5
val-5 ::= ("[" ws str (ws "," ws str)* ws "]" | "null")
kv-6 ::= "batteryCurve" ":" val-6
val-6 ::= ("[" ws str (ws "," ws str)* ws "]" | "null")
kv-7 ::= "minChargeAtDestinationPercent" ":" val-7
val-7 ::= (num | "null")
kv-8 ::= "minChargeAtChargingStopsPercent" ":" val-8
val-8 ::= (num | "null")
kv-9 ::= "routeType" ":" val-9
val-9 ::= ("fast" | "short" | "efficient" | "null")
kv-10 ::= "traffic" ":" val-10
val-10 ::= ("live" | "historical" | "null")
kv-11 ::= "avoid" ":" val-11
val-11 ::= ("[" ws str (ws "," ws str)* ws "]" | "null")
kv-12 ::= "departAt" ":" val-12
val-12 ::= (str | "null")
kv-13 ::= "show_ui" ":" val-13
val-13 ::= ("true" | "false" | "null")
kv-14 ::= "response_detail" ":" val-14
val-14 ::= ("compact" | "geometry" | "full" | "null")
