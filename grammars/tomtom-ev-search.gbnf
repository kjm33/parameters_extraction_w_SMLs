root ::= "{" kvs "}"
kvs ::= kv-0 "," kv-1 "," kv-2 "," kv-3 "," kv-4 "," kv-5 "," kv-6 "," kv-7 "," kv-8 "," kv-9 "," kv-10
ws ::= [ \t\n]*
str ::= "\"" ([^"\\\x7F\x00-\x1F] | "\\" (["\\bfnrt] | "u" [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F]))* "\""
num ::= [0-9]+
kv-0 ::= "query" ":" val-0
val-0 ::= (str | "null")
kv-1 ::= "position" ":" val-1
val-1 ::= ("[" ws str (ws "," ws str)* ws "]" | "null")
kv-2 ::= "radius" ":" val-2
val-2 ::= (num | "null")
kv-3 ::= "connectorTypes" ":" val-3
val-3 ::= ("[" ws str (ws "," ws str)* ws "]" | "null")
kv-4 ::= "minPowerKW" ":" val-4
val-4 ::= (num | "null")
kv-5 ::= "limit" ":" val-5
val-5 ::= (num | "null")
kv-6 ::= "includeAvailability" ":" val-6
val-6 ::= ("true" | "false" | "null")
kv-7 ::= "language" ":" val-7
val-7 ::= (str | "null")
kv-8 ::= "countries" ":" val-8
val-8 ::= ("[" ws str (ws "," ws str)* ws "]" | "null")
kv-9 ::= "show_ui" ":" val-9
val-9 ::= ("true" | "false" | "null")
kv-10 ::= "response_detail" ":" val-10
val-10 ::= ("compact" | "full" | "null")
