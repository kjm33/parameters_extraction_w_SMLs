root ::= "{" kvs "}"
kvs ::= kv-0 "," kv-1 "," kv-2 "," kv-3 "," kv-4 "," kv-5 "," kv-6 "," kv-7 "," kv-8 "," kv-9 "," kv-10 "," kv-11 "," kv-12 "," kv-13 "," kv-14 "," kv-15 "," kv-16
ws ::= [ \t\n]*
str ::= "\"" ([^"\\\x7F\x00-\x1F] | "\\" (["\\bfnrt] | "u" [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F]))* "\""
num ::= [0-9]+
kv-0 ::= "query" ":" val-0
val-0 ::= (str | "null")
kv-1 ::= "response_detail" ":" val-1
val-1 ::= ("compact" | "full" | "null")
kv-2 ::= "limit" ":" val-2
val-2 ::= (num | "null")
kv-3 ::= "language" ":" val-3
val-3 ::= (str | "null")
kv-4 ::= "countrySet" ":" val-4
val-4 ::= (str | "null")
kv-5 ::= "view" ":" val-5
val-5 ::= (str | "null")
kv-6 ::= "extendedPostalCodesFor" ":" val-6
val-6 ::= (str | "null")
kv-7 ::= "mapcodes" ":" val-7
val-7 ::= ("[" ws str (ws "," ws str)* ws "]" | "null")
kv-8 ::= "timeZone" ":" val-8
val-8 ::= (str | "null")
kv-9 ::= "geometries" ":" val-9
val-9 ::= ("true" | "false" | "null")
kv-10 ::= "addressRanges" ":" val-10
val-10 ::= ("true" | "false" | "null")
kv-11 ::= "lat" ":" val-11
val-11 ::= (num | "null")
kv-12 ::= "lon" ":" val-12
val-12 ::= (num | "null")
kv-13 ::= "radius" ":" val-13
val-13 ::= (num | "null")
kv-14 ::= "topLeft" ":" val-14
val-14 ::= (str | "null")
kv-15 ::= "btmRight" ":" val-15
val-15 ::= (str | "null")
kv-16 ::= "entityTypeSet" ":" val-16
val-16 ::= (str | "null")
