root ::= "{" kvs "}"
kvs ::= kv-0 "," kv-1 "," kv-2 "," kv-3 "," kv-4 "," kv-5 "," kv-6 "," kv-7 "," kv-8 "," kv-9 "," kv-10 "," kv-11 "," kv-12 "," kv-13 "," kv-14 "," kv-15 "," kv-16 "," kv-17 "," kv-18 "," kv-19 "," kv-20 "," kv-21 "," kv-22 "," kv-23 "," kv-24 "," kv-25 "," kv-26 "," kv-27 "," kv-28 "," kv-29 "," kv-30 "," kv-31 "," kv-32 "," kv-33 "," kv-34 "," kv-35 "," kv-36 "," kv-37 "," kv-38 "," kv-39 "," kv-40
ws ::= [ \t\n]*
str ::= "\"" ([^"\\\x7F\x00-\x1F] | "\\" (["\\bfnrt] | "u" [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F]))* "\""
num ::= [0-9]+
kv-0 ::= "origin" ":" val-0
