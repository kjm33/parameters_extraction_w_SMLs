root ::= "{" kvs "}"
kvs ::= kv-0 "," kv-1 "," kv-2 "," kv-3 "," kv-4 "," kv-5 "," kv-6 "," kv-7 "," kv-8 "," kv-9 "," kv-10 "," kv-11 "," kv-12 "," kv-13 "," kv-14 "," kv-15 "," kv-16 "," kv-17 "," kv-18
ws ::= [ \t\n]*
str ::= "\"" ([^"\\\x7F\x00-\x1F] | "\\" (["\\bfnrt] | "u" [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F]))* "\""
num ::= [0-9]+
kv-0 ::= "position" ":" val-0
val-0 ::= ("[" ws str (ws "," ws str)* ws "]" | "null")
kv-1 ::= "show_ui" ":" val-1
val-1 ::= ("true" | "false" | "null")
kv-2 ::= "response_detail" ":" val-2
val-2 ::= ("compact" | "full" | "null")
kv-3 ::= "limit" ":" val-3
val-3 ::= (num | "null")
kv-4 ::= "language" ":" val-4
val-4 ::= (str | "null")
kv-5 ::= "countries" ":" val-5
val-5 ::= ("[" ws str (ws "," ws str)* ws "]" | "null")
kv-6 ::= "view" ":" val-6
val-6 ::= (str | "null")
kv-7 ::= "extendedPostalCodesFor" ":" val-7
val-7 ::= (str | "null")
kv-8 ::= "mapcodes" ":" val-8
val-8 ::= ("[" ws str (ws "," ws str)* ws "]" | "null")
kv-9 ::= "timeZone" ":" val-9
val-9 ::= (str | "null")
kv-10 ::= "radius" ":" val-10
val-10 ::= (num | "null")
kv-11 ::= "returnMatchType" ":" val-11
val-11 ::= ("true" | "false" | "null")
kv-12 ::= "returnSpeedLimit" ":" val-12
val-12 ::= ("true" | "false" | "null")
kv-13 ::= "allowFreeformNewLine" ":" val-13
val-13 ::= ("true" | "false" | "null")
kv-14 ::= "heading" ":" val-14
val-14 ::= (num | "null")
kv-15 ::= "returnRoadClass" ":" val-15
val-15 ::= (str | "null")
kv-16 ::= "entityType" ":" val-16
val-16 ::= (str | "null")
kv-17 ::= "callback" ":" val-17
val-17 ::= (str | "null")
kv-18 ::= "filter" ":" val-18
val-18 ::= (str | "null")
