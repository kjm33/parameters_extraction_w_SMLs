root ::= "{" kvs "}"
kvs ::= kv-0 "," kv-1 "," kv-2 "," kv-3 "," kv-4 "," kv-5 "," kv-6 "," kv-7 "," kv-8 "," kv-9
ws ::= [ \t\n]*
str ::= "\"" ([^"\\\x7F\x00-\x1F] | "\\" (["\\bfnrt] | "u" [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F]))* "\""
num ::= [0-9]+
kv-0 ::= "origin" ":" val-0
val-0 ::= ("[" ws str (ws "," ws str)* ws "]" | "null")
kv-1 ::= "destination" ":" val-1
val-1 ::= ("[" ws str (ws "," ws str)* ws "]" | "null")
kv-2 ::= "query" ":" val-2
val-2 ::= (str | "null")
kv-3 ::= "corridorWidth" ":" val-3
val-3 ::= (num | "null")
kv-4 ::= "limit" ":" val-4
val-4 ::= (num | "null")
kv-5 ::= "poiCategories" ":" val-5
val-5 ::= ("[" ws str (ws "," ws str)* ws "]" | "null")
kv-6 ::= "language" ":" val-6
val-6 ::= (str | "null")
kv-7 ::= "routeType" ":" val-7
val-7 ::= ("fast" | "short" | "efficient" | "null")
kv-8 ::= "show_ui" ":" val-8
val-8 ::= ("true" | "false" | "null")
kv-9 ::= "response_detail" ":" val-9
val-9 ::= ("compact" | "geometry" | "full" | "null")
