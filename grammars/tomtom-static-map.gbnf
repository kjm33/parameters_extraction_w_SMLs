root ::= "{" kvs "}"
kvs ::= kv-0 "," kv-1 "," kv-2 "," kv-3 "," kv-4 "," kv-5 "," kv-6 "," kv-7 "," kv-8 "," kv-9
ws ::= [ \t\n]*
str ::= "\"" ([^"\\\x7F\x00-\x1F] | "\\" (["\\bfnrt] | "u" [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F]))* "\""
num ::= [0-9]+
kv-0 ::= "center" ":" val-0
val-0 ::= (str | "null")
kv-1 ::= "bbox" ":" val-1
val-1 ::= ("[" ws str (ws "," ws str)* ws "]" | "null")
kv-2 ::= "zoom" ":" val-2
val-2 ::= (num | "null")
kv-3 ::= "width" ":" val-3
val-3 ::= (num | "null")
kv-4 ::= "height" ":" val-4
val-4 ::= (num | "null")
kv-5 ::= "style" ":" val-5
val-5 ::= ("main" | "night" | "null")
kv-6 ::= "layer" ":" val-6
val-6 ::= ("basic" | "labels" | "hybrid" | "null")
kv-7 ::= "format" ":" val-7
val-7 ::= ("png" | "jpg" | "null")
kv-8 ::= "view" ":" val-8
val-8 ::= ("Unified" | "IL" | "IN" | "MA" | "PK" | "AR" | "Arabic" | "RU" | "TR" | "CN" | "US" | "null")
kv-9 ::= "language" ":" val-9
val-9 ::= (str | "null")
